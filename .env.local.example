# LLM Providers (using Groq + OpenRouter for cost efficiency)
GROQ_API_KEY=your_groq_api_key
OPENROUTER_API_KEY=your_openrouter_api_key
ANTHROPIC_API_KEY=your_anthropic_api_key_optional

# Stripe
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret

# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Email delivery
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=your_brevo_smtp_user
BREVO_SMTP_PASSWORD=your_brevo_smtp_password
BREVO_FROM_EMAIL=noreply@equidamai.com
BREVO_FROM_NAME=Evaldam AI

# Scheduled jobs and webhooks
CRON_SECRET=your_strong_cron_secret
EMAIL_WEBHOOK_SECRET=your_strong_email_webhook_secret
INTERNAL_RATE_UPDATE_KEY=your_internal_rate_update_key

# Optional market/data enrichment
NEWS_API_KEY=your_news_api_key_optional
CRUNCHBASE_API_KEY=your_crunchbase_api_key_optional
ANGELLIST_API_KEY=your_angellist_api_key_optional
FRED_API_KEY=your_fred_api_key_optional
PROXYCURL_API_KEY=your_proxycurl_api_key_optional

# Admin fallback until DB roles are configured
ADMIN_EMAIL=admin@equidamai.com

# App Config
NEXT_PUBLIC_SITE_URL=https://equidamai.com
NODE_ENV=development
PREFERRED_LLM_PROVIDER=groq
