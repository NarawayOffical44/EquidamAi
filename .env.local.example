# LLM Providers (using Groq + OpenRouter for cost efficiency)
GROQ_API_KEY=your_groq_api_key
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_API_KEY2=your_backup_openrouter_api_key_optional
OPENROUTER_FALLBACK_MODELS=openai/gpt-oss-20b:free,google/gemma-4-26b-a4b-it:free
ANTHROPIC_API_KEY=your_anthropic_api_key_optional

# Evaldam Startup AI
INDIA_FINANCE_AI_PROVIDER=groq
INDIA_FINANCE_AI_LIMITER_ENABLED=false
GROQ_MODEL=llama-3.3-70b-versatile
OPENROUTER_MODEL=deepseek/deepseek-v4-flash:free
