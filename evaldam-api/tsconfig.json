{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "outDir": "./dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"]
    },
    "moduleResolution": "node"
  },
  "ts-node": {
    "esm": false,
    "experimentalEsm": false,
    "compilerOptions": {
      "module": "commonjs"
    }
  },
  "include": ["src/**/*", "lib/**/*", "types/**/*"],
  "exclude": ["node_modules", "dist", "lib/pdf/**/*", "lib/supabase/**/*", "lib/utils/response.ts", "lib/utils/validation.ts", "lib/config/index.ts*"]
}
